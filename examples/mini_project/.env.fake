# FAKE demonstration file only - every value below is invented,
# labelled fake, and is not a real credential. GhostEnv never
# prints values like these; this file exists only to show what a
# local .env might look like in shape. Do not copy this pattern
# with real values into anything you share.
DATABASE_URL=postgres://fake-user:FAKE_password_not_real@localhost/fake_db
DEMO_API_KEY=FAKE_demo_key_not_real_0000
CACHE_TTL_SECONDS=FAKE_ttl_not_real
